#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/tensordesk/tensordesk /usr/bin/tensordesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/tensordesk.service ]; then
			rm -f /etc/systemd/system/tensordesk.service /usr/lib/systemd/system/tensordesk.service /usr/lib/systemd/user/tensordesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/tensordesk/files/systemd/tensordesk.service /usr/lib/systemd/system/tensordesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload tensordesk.service: Unit tensordesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/tensordesk.service:10: Executable path is not absolute: pkill -f "tensordesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/tensordesk.service
		fi
		systemctl daemon-reload
		systemctl enable tensordesk
		systemctl start tensordesk
	fi
fi
